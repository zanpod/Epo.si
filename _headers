# Netlify custom headers — https://docs.netlify.com/routing/headers/
# CSS/JS filenames never change (no build step/hashing), so any fixed
# max-age makes browsers keep serving an old file for that whole window
# after a deploy, no matter how many times the visitor refreshes — this
# bit us directly once already. `no-cache` still lets the browser keep a
# cached copy, but forces a revalidation request (ETag) on every load:
# unchanged files come back as a fast, bodyless 304, changed ones are
# fetched fresh immediately. Images/favicon keep a real cache lifetime
# since a changed image gets a new URL (admin re-uploads), so nothing
# there is ever silently stale.

/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/images/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=604800
